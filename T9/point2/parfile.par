THC_Core::atmo_tolerance    = 1e-2
THC_Core::atmo_I_know_what_I_am_doing   = "yes"



THC_Core::c2a_BH_alp            = 0.15
THC_Core::c2a_rho_strict                = 2e-5
THC_Core::c2a_set_to_nan_on_failure             = "no"
